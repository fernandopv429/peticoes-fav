# Copie para .env (local) ou cole em Environment Variables no Coolify (produção).
# NUNCA versione o .env: ele carrega chave da Anthropic e token do PocketBase.

# --- autenticação do próprio serviço -----------------------------------------
# Chave que o cliente envia no header X-API-Key. Sem ela o serviço
# responde 503 e NÃO gera peça — é proposital: a URL do Coolify é pública e cada
# chamada gasta uma requisição Opus e grava dados de cliente.
# Gere com:  openssl rand -hex 32
API_KEY=

# --- redação (Claude) ---------------------------------------------------------
# Modelos atuais: claude-opus-5 / claude-haiku-4-5.
# Atenção: `temperature` foi REMOVIDO no Opus 5 — enviar retorna 400.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- base de CCTs (pgvector) — já em produção ---------------------------------
CCT_API_URL=https://ccts.nexusdevhub.com
CCT_API_KEY=

# --- HTML -> PDF (Gotenberg) --------------------------------------------------
# Conversor HTML->PDF. Cada peça faz três renderizações (capa, miolo, faixa do
# rodapé). Sem estas três variáveis, gerar PDF falha com erro claro.
GOTENBERG_URL=http://72.60.61.18:3000
GOTENBERG_USER=
GOTENBERG_PASSWORD=

# --- PocketBase — estado das peças (caso.json, peca.html, PDF) ----------------
# Token de SERVIÇO, gerado no Admin UI via "Impersonate" com validade longa.
# Não usar e-mail/senha de superusuário no serviço.
POCKETBASE_URL=https://db.nexusdevhub.com
POCKETBASE_TOKEN=
